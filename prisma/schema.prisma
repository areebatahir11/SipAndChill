// Sip&Chill / PearlSolutions - Step 1: tenancy, auth and RBAC.
// Later modules (products, ingredients, orders...) add their own tenant-owned tables.
// Step 4 adds the PearlSolutions platform layer: User.isPlatformAdmin and per-client billing on Tenant.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (app runtime)
  directUrl = env("DIRECT_URL")   // direct connection (migrations)
}

model Tenant {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  nameKey      String?  @unique // businessNameKey(name): one business per name, ignoring case/punctuation/"&". Null only for legacy duplicates.
  businessType String   @default("JUICE_SHOP") // future: COFFEE_SHOP, ICE_CREAM_SHOP
  currency     String   @default("PKR")
  isActive     Boolean  @default(true) // false = suspended by PearlSolutions: nobody of this client can sign in
  status       String   @default("ACTIVE") // ACTIVE | PENDING (signed up, waiting for PearlSolutions approval) | REJECTED. Pending/rejected tenants also have isActive = false.
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Step 4: what PearlSolutions charges this client and whether they have paid.
  billingStatus String    @default("UNPAID") // PAID | UNPAID
  monthlyFee    Decimal   @default(0) @db.Decimal(12, 2)
  dueDate       DateTime? // next payment due date
  lastPaidAt    DateTime?
  internalNote  String?   // visible to PearlSolutions only

  // Branding: null = no logo. The picture itself lives in TenantLogo (kept out of this row so normal queries never load it);
  // this timestamp is the cache-busting version the sidebar puts in the image URL.
  logoUpdatedAt DateTime?

  logo           TenantLogo?
  termsAcceptances TermsAcceptance[]
  memberships    Membership[]
  auditLogs      AuditLog[]
  settings       TenantSettings?
  suppliers      Supplier[]
  ingredients    Ingredient[]
  stockMovements StockMovement[]
  categories     Category[]
  products       Product[]
  orders         Order[]
}

// Per-business settings (one row per tenant). Receipt options are used by Step 7.
model TenantSettings {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  phone          String?
  address        String?
  receiptWidthMm Int      @default(80) // 58 or 80
  receiptFooter  String   @default("Thank you! Visit again.")
  nextOrderNo    Int      @default(1) // Step 5: per-business order number, incremented inside the order transaction
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// One small logo picture per business (max 300 KB, validated by file signature), uploaded by the owner in Shop Settings.
model TenantLogo {
  tenantId    String   @id
  contentType String   // image/png | image/jpeg | image/webp
  data        Bytes
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique // always stored lower-case
  name             String
  passwordHash     String
  isActive         Boolean   @default(true)
  isPlatformAdmin  Boolean   @default(false) // PearlSolutions staff: signs in to /platform, has no tenant membership
  mustChangePassword Boolean @default(false) // true while the password was set by someone else: the user must choose their own before using the app
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  memberships Membership[]
  sessions    Session[]
  passwordResetOtps PasswordResetOtp[]
  termsAcceptances  TermsAcceptance[]
  auditLogs   AuditLog[]
  stockMovements StockMovement[]
  orders         Order[]
}

// A user's access to one tenant, with one role. This is the tenant-isolation anchor:
// every request resolves tenantId from the membership, never from the client.
model Membership {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  roleId    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role      @relation(fields: [roleId], references: [id])
  sessions Session[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([roleId])
}

// System roles: OWNER, MANAGER, CASHIER, INVENTORY_STAFF. Custom per-tenant roles can add a
// nullable tenantId later without touching the permission checks.
model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  rank        Int      @default(0) // higher = more authority; users only manage lower ranks (owners: equal too)
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  memberships Membership[]
}

model Permission {
  id          String @id @default(cuid())
  code        String @unique // e.g. "orders.create"
  module      String
  description String

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// Server-side sessions. Only a SHA-256 hash of the cookie token is stored, so a database
// leak does not expose usable session tokens.
model Session {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  userId       String
  membershipId String? // null for PearlSolutions platform sessions
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  ipAddress    String?
  userAgent    String?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}


// Short-lived, single-use email OTPs for self-service password recovery.
model PasswordResetOtp {
  id         String   @id @default(cuid())
  userId     String
  otpHash    String
  expiresAt  DateTime
  attempts   Int      @default(0)
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// A public signup that has not verified its email yet. No Tenant/User exists until the 6-digit code is confirmed, so
// bots and mistyped emails never create junk businesses. One row per email; a new request replaces the old one.
// Holds a password HASH, so this table must stay locked by RLS (prisma/supabase-rls.sql).
model SignupRequest {
  id              String   @id @default(cuid())
  email           String   @unique
  businessName    String
  nameKey         String?
  businessType    String
  ownerName       String
  passwordHash    String
  otpHash         String
  attempts        Int      @default(0)
  expiresAt       DateTime
  sendCount       Int      @default(1) // codes sent inside the current hour window
  windowStartedAt DateTime
  lastSentAt      DateTime
  ipAddress       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ipAddress, updatedAt])
  @@index([expiresAt])
  @@index([nameKey])
}

// Proof that a business owner accepted a version of the Terms & Conditions (kept forever as evidence).
model TermsAcceptance {
  id         String   @id @default(cuid())
  userId     String
  tenantId   String
  version    String
  acceptedAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, version])
  @@index([tenantId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  action    String // e.g. "staff.created", "auth.login"
  entity    String?
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Step 2: inventory. Every table carries tenantId; services always filter by it.
// ---------------------------------------------------------------------------

model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ingredients Ingredient[]

  @@unique([tenantId, name])
}

// One table for both food ingredients (kind INGREDIENT: oranges, milk) and non-food
// materials (kind MATERIAL: cups, straws, receipt rolls).
model Ingredient {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  kind         String    @default("INGREDIENT") // INGREDIENT | MATERIAL
  unit         String // kg, g, L, ml, pcs ...
  stock        Decimal   @default(0) @db.Decimal(12, 3)
  minStock     Decimal   @default(0) @db.Decimal(12, 3) // reorder level
  costPerUnit  Decimal   @default(0) @db.Decimal(12, 2)
  expiryDate   DateTime?
  supplierId   String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier  Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  movements   StockMovement[]
  recipeItems RecipeItem[]

  @@unique([tenantId, name])
  @@index([tenantId, kind])
  @@index([supplierId])
}

// Append-only stock ledger. quantity is signed: + adds stock, - removes it.
// type: OPENING | PURCHASE | ADJUSTMENT | WASTAGE | USAGE (sale) | ORDER_CANCEL (restock on cancel)
model StockMovement {
  id           String   @id @default(cuid())
  tenantId     String
  ingredientId String
  type         String
  quantity     Decimal  @db.Decimal(12, 3)
  unitCost     Decimal? @db.Decimal(12, 2)
  note         String?
  userId       String?
  orderId      String? // set for USAGE (sale) and ORDER_CANCEL (restock) movements
  createdAt    DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  order      Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([ingredientId, createdAt])
  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Step 3: menu. Categories group products; a product's recipe lists the stock it consumes.
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
}

model Product {
  id          String   @id @default(cuid())
  tenantId    String
  categoryId  String?
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  isActive    Boolean  @default(true) // false = hidden from the POS
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recipeItems RecipeItem[]
  orderItems  OrderItem[]
  image       ProductImage? // the picture itself lives in ProductImage so normal menu queries never load the bytes

  @@unique([tenantId, name])
  @@index([tenantId, categoryId])
}

// One small picture per menu item (max 150 KB, validated by file signature; the browser shrinks big photos first).
// Served by GET /api/products/:id/image?v=<updatedAt> with a one-year cache, so the counter loads each picture once.
model ProductImage {
  productId   String   @id
  tenantId    String
  contentType String // image/png | image/jpeg | image/webp
  data        Bytes
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Stock consumed by ONE unit of the product (Step 5 deducts it when an order is placed).
model RecipeItem {
  id           String  @id @default(cuid())
  tenantId     String
  productId    String
  ingredientId String
  quantity     Decimal @db.Decimal(12, 3)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([productId, ingredientId])
  @@index([tenantId])
  @@index([ingredientId])
}

// ---------------------------------------------------------------------------
// Step 5: orders and payments. Order items are SNAPSHOTS (name, unit price), so later menu
// edits never change history. Money is DECIMAL(12,2); the app computes it in integer paisa.
// ---------------------------------------------------------------------------

model Order {
  id              String    @id @default(cuid())
  tenantId        String
  orderNo         Int // lifetime sequence, unique per tenant, never reused (see TenantSettings.nextOrderNo). Internal/audit; staff see dailyNo.
  businessDate    DateTime  @db.Date // the shop's calendar day (Asia/Karachi) this order belongs to
  dailyNo         Int // the number staff and customers see: restarts at 1 every business day
  clientRequestId String // idempotency key generated by the POS: a retry returns the same order
  status          String    @default("COMPLETED") // COMPLETED | CANCELLED
  paymentStatus   String    @default("UNPAID") // PAID | PARTIAL | UNPAID
  subtotal        Decimal   @db.Decimal(12, 2)
  discount        Decimal   @default(0) @db.Decimal(12, 2) // promotion discount applied by the server (see lib/promotions); 0 = none
  discountLabel   String? // snapshot of the promotion name, e.g. "20% OFF", so receipts reprint identically later
  // Receipt printing. "What we know", never a promise that paper came out (see src/lib/orders/print-status.mjs).
  printStatus      String    @default("NOT_REQUESTED") // NOT_REQUESTED | SENT | CONFIRMED | PROBLEM | DIALOG_OPENED
  printAttempts    Int       @default(0)
  lastPrintAt      DateTime?
  printConfirmedAt DateTime?
  total           Decimal   @db.Decimal(12, 2)
  amountPaid      Decimal   @default(0) @db.Decimal(12, 2) // cash actually applied to this order (never includes change)
  cashierId       String?
  cashierName     String // snapshot for receipts
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime  @default(now())

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashier   User?           @relation(fields: [cashierId], references: [id], onDelete: SetNull)
  items     OrderItem[]
  payments  Payment[]
  movements StockMovement[]

  @@unique([tenantId, orderNo])
  @@unique([tenantId, businessDate, dailyNo])
  @@unique([tenantId, clientRequestId])
  @@index([tenantId, businessDate])
  @@index([tenantId, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, printStatus, lastPrintAt])
  @@index([cashierId])
}

model OrderItem {
  id        String  @id @default(cuid())
  tenantId  String
  orderId   String
  productId String? // kept for reports; null if the product is ever removed
  name      String // snapshot
  unitPrice Decimal @db.Decimal(12, 2) // snapshot
  quantity  Int
  lineTotal Decimal @db.Decimal(12, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([tenantId, productId])
}

// One row per cash handover. amountReceived = what the customer gave; amountApplied = the part
// that settled the order; changeReturned = amountReceived - amountApplied (NOT a refund).
model Payment {
  id             String   @id @default(cuid())
  tenantId       String
  orderId        String
  method         String   @default("CASH")
  amountReceived Decimal  @db.Decimal(12, 2)
  amountApplied  Decimal  @db.Decimal(12, 2)
  changeReturned Decimal  @default(0) @db.Decimal(12, 2)
  userId         String?
  createdAt      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([tenantId, createdAt])
}
