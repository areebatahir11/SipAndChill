# Copy to .env (never commit .env)

# --- Supabase (Project Settings > Database > Connection string) ---
# Runtime: "Transaction pooler" (port 6543). Keep ?pgbouncer=true
DATABASE_URL="postgresql://postgres.PROJECTREF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations: "Session pooler" (port 5432) or Direct connection
DIRECT_URL="postgresql://postgres.PROJECTREF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Local PostgreSQL alternative: use the same URL for both ---
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sipchill"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/sipchill"

# First Business Admin, used only by `npm run db:seed`
SEED_ADMIN_NAME="Owner"
SEED_ADMIN_EMAIL="owner@example.com"
SEED_ADMIN_PASSWORD="ChangeMe-12345"
