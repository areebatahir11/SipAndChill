# Copy to .env (never commit .env)

# Database (Supabase / Postgres). Use your own values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

SEED_PLATFORM_NAME="PearlSolutions Admin"
SEED_PLATFORM_EMAIL=admin@example.com
SEED_PLATFORM_PASSWORD=change-me

APP_URL=http://localhost:3000
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASSWORD=change-me
MAIL_FROM="PearlSolutions <you@example.com>"

SIGNUP_MODE=approval
ADMIN_NOTIFY_EMAIL=you@example.com

# Your bank details, shown to client owners on Plan & Billing -> "How to pay" (optional).
# BILLING_BANK_NAME="Your Bank Name"
# BILLING_ACCOUNT_TITLE="Account holder name"
# BILLING_ACCOUNT_NUMBER="0000000000000"
# BILLING_IBAN="PK00XXXX0000000000000000"
# BILLING_SUPPORT_EMAIL=you@example.com   # for "already paid?" questions; defaults to ADMIN_NOTIFY_EMAIL

# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
