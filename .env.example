# Copy to .env and fill in your own values. NEVER commit .env and never write real passwords or hints in comments here.

# Database (Supabase or any PostgreSQL). Special characters in the password must be URL-encoded (@ becomes %40).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# First PearlSolutions super admin created by `npm run db:seed` (password: 10-72 characters, with a letter and a number)
SEED_PLATFORM_NAME="PearlSolutions Admin"
SEED_PLATFORM_EMAIL=admin@example.com
SEED_PLATFORM_PASSWORD=change-me-before-seeding-1

# Public address of the site (used in emails)
APP_URL=http://localhost:3000

# Outgoing email for password-recovery codes (Gmail: use an App Password, port 465)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
MAIL_FROM="PearlSolutions <you@example.com>"
