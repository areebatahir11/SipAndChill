# Copy to .env and fill in your own values. NEVER commit .env and never write real passwords or hints in comments here.

# Database (Supabase or any PostgreSQL). Special characters in the password must be URL-encoded (@ becomes %40).
# Supabase pooler (port 6543): the extra options stop "Can't reach database server" / timeouts on a sleepy pooler.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=5&connect_timeout=30&pool_timeout=30"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# First PearlSolutions super admin created by `npm run db:seed` (password: 10-72 characters, with a letter and a number)
SEED_PLATFORM_NAME="PearlSolutions Admin"
SEED_PLATFORM_EMAIL=admin@example.com
SEED_PLATFORM_PASSWORD=change-me-before-seeding-1

# Public address of the site (used in emails)
APP_URL=http://localhost:3000

# Who can sign up by themselves:
#   approval    (default) verify email, then PearlSolutions approves each business by hand
#   open        verify email, business is active immediately with a free trial
#   invite_only public signup is closed; PearlSolutions adds clients itself
SIGNUP_MODE=approval
# Where "new signup waiting for approval" emails go (comma separated). Empty = every active PearlSolutions admin.
ADMIN_NOTIFY_EMAIL=

# Cloudflare Turnstile (free CAPTCHA on signup). Create a widget at dash.cloudflare.com > Turnstile, add your site's hostname.
# Leave both empty to switch the check off. The site key is public; the secret key must stay private.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Outgoing email for verification and password-recovery codes (Gmail: use an App Password, port 465)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
MAIL_FROM="PearlSolutions <you@example.com>"
# Resend instead of Gmail (no code change): SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_USER=resend, SMTP_PASSWORD=<Resend API key>,
# MAIL_FROM must use a domain you verified in Resend.
